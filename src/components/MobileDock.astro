---
import { primaryPhoneHref, site } from '../data/site';
---

<nav class="mobile-dock" aria-label="Quick actions">
  <a class="mobile-dock__call" href={primaryPhoneHref()}>
    <span class="mobile-dock__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" width="18" height="18">
        <path
          d="M6.5 4.5h3l1.2 3.2-1.6 1.6a12.5 12.5 0 0 0 5.6 5.6l1.6-1.6 3.2 1.2v3a1.5 1.5 0 0 1-1.6 1.5A15.5 15.5 0 0 1 5 6.1a1.5 1.5 0 0 1 1.5-1.6Z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <span class="mobile-dock__label">{site.cta.callLabel}</span>
  </a>
  <button type="button" class="mobile-dock__estimate" data-open-contact="estimate">
    <span class="mobile-dock__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" width="18" height="18">
        <path
          d="M5 6.5h14M5 12h14M5 17.5h9"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </span>
    <span class="mobile-dock__label">Free Estimate</span>
  </button>
</nav>

<style>
  .mobile-dock {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-dock {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      padding: 0.55rem 0.65rem calc(0.55rem + env(safe-area-inset-bottom));
      background: var(--cream);
      border-top: 3px solid var(--ink);
      box-shadow: 0 -4px 0 rgba(40, 35, 165, 0.12);
    }

    .mobile-dock__call,
    .mobile-dock__estimate {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      min-height: 3rem;
      padding: 0.55rem 0.65rem;
      border: 3px solid var(--ink);
      border-radius: var(--radius);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 3px 3px 0 var(--ink);
    }

    .mobile-dock__call {
      background: var(--blue);
      color: var(--cream);
    }

    .mobile-dock__estimate {
      background: var(--yellow);
      color: var(--ink);
    }

    .mobile-dock__icon {
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }
  }
</style>
