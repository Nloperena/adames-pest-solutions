---
import { processSteps } from '../../data/process';
---

<section class="section process" aria-labelledby="process-heading">
  <div class="container">
    <p class="section-label">How it works</p>
    <h2 class="section-title" id="process-heading">We find it. Treat it. Keep it out.</h2>

    <ol class="process__steps">
      {
        processSteps.map((step, index) => (
          <li class="process__step">
            <div class="process__number">{step.number}</div>
            <div class="process__content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
            {index < processSteps.length - 1 && (
              <span class="process__arrow" aria-hidden="true">→</span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    background: var(--white);
    border-block: 3px solid var(--ink);
  }

  .process__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .process__step {
    position: relative;
    display: grid;
    gap: 1rem;
    min-height: 15rem;
    padding: 1.5rem;
    border: 3px solid var(--ink);
    background: var(--cream);
    box-shadow: var(--shadow-sm);
  }

  .process__step:nth-child(2) {
    background: var(--yellow);
  }

  .process__step:nth-child(3) {
    background: var(--blue);
    color: var(--white);
  }

  .process__number {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 5rem);
    line-height: 0.8;
  }

  .process__content h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    text-transform: uppercase;
  }

  .process__content p {
    margin: 0;
  }

  .process__arrow {
    position: absolute;
    top: 1.25rem;
    right: 1rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--blue);
  }

  .process__step:nth-child(3) .process__arrow {
    display: none;
  }

  @media (max-width: 860px) {
    .process__steps {
      grid-template-columns: 1fr;
    }

    .process__arrow {
      display: none;
    }
  }
</style>
