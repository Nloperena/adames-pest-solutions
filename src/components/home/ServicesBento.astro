---
import { legacyImages, serviceLegacyImage } from '../../data/legacyImages';
import { services } from '../../data/services';

const teasers: Record<string, string> = {
  'pest-control': 'Palmetto bugs, ants, and more — treated after a real inspection.',
  'rodent-control': 'Roof rats and mice: trap, remove, and close the gaps.',
  'termite-control': 'Central Florida termite pressure. Inspect early.',
  'commercial-services': 'Keep pests out of kitchens, rooms, and lobbies.',
};

/** Heroic lead visual for the featured residential card */
const featuredImage = legacyImages.bannerTechnician;
---

<section class="section services" id="services" aria-labelledby="services-heading">
  <div class="container">
    <p class="section-label">Services</p>
    <h2 class="section-title" id="services-heading">Pest control for Florida homes & businesses.</h2>
    <p class="section-lead">
      The problems Central Florida searches for — from palmetto bugs to termites — with a local plan.
    </p>

    <div class="services__bento">
      {
        services.map((service, index) => {
          const image = index === 0 ? featuredImage : serviceLegacyImage[service.id];
          const featured = index === 0;
          return (
            <a
              class={`service-card${featured ? ' service-card--featured' : ''}`}
              href={service.href}
            >
              {image && (
                <img
                  class="service-card__bg"
                  src={image.src}
                  alt=""
                  width={image.width}
                  height={image.height}
                  loading={featured ? 'eager' : 'lazy'}
                  decoding="async"
                  aria-hidden="true"
                />
              )}
              <span class="service-card__number" aria-hidden="true">
                {service.number}
              </span>
              <div class="service-card__copy">
                <h3>{service.navLabel}</h3>
                <p>{teasers[service.id]}</p>
                <span class="service-card__cta">Explore service →</span>
              </div>
              <span class="service-card__chevron" aria-hidden="true">›</span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .services__bento {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-template-rows: repeat(3, minmax(11rem, 1fr));
    gap: 1rem;
    margin-top: 2.25rem;
    min-height: min(72vh, 38rem);
  }

  .service-card {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 11rem;
    border: 4px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 6px 6px 0 var(--ink);
    overflow: hidden;
    text-decoration: none;
    color: var(--cream);
    background: var(--ink);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .service-card--featured {
    grid-row: 1 / -1;
    min-height: 100%;
  }

  .service-card:hover,
  .service-card:focus-visible {
    transform: translate(-5px, -5px);
    box-shadow: 10px 10px 0 var(--blue);
  }

  .service-card__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 280ms ease;
  }

  .service-card--featured .service-card__bg {
    object-position: left center;
  }

  .service-card:hover .service-card__bg {
    transform: scale(1.05);
  }

  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      185deg,
      rgba(21, 21, 21, 0.05) 20%,
      rgba(21, 21, 21, 0.45) 55%,
      rgba(21, 21, 21, 0.88) 100%
    );
    pointer-events: none;
  }

  .service-card__number {
    position: absolute;
    top: 0.65rem;
    right: 0.75rem;
    z-index: 2;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 0.8;
    color: var(--yellow);
    opacity: 0.9;
    text-shadow: 3px 3px 0 var(--ink);
    pointer-events: none;
  }

  .service-card--featured .service-card__number {
    font-size: clamp(5rem, 12vw, 9rem);
    top: 1rem;
    right: 1rem;
  }

  .service-card__copy {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 1.15rem 1.2rem 1.25rem;
    display: grid;
    gap: 0.45rem;
  }

  .service-card--featured .service-card__copy {
    padding: 1.5rem 1.6rem 1.75rem;
    max-width: 28rem;
  }

  .service-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3.5vw, 2.35rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--cream);
  }

  .service-card--featured h3 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    max-width: 10ch;
  }

  .service-card p {
    margin: 0;
    max-width: 34ch;
    font-size: 0.98rem;
    line-height: 1.35;
    color: rgba(247, 243, 232, 0.92);
  }

  .service-card--featured p {
    font-size: 1.1rem;
  }

  .service-card__cta {
    display: inline-flex;
    align-self: start;
    margin-top: 0.35rem;
    padding: 0.55rem 0.8rem;
    background: var(--yellow);
    border: 3px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-card:hover .service-card__cta {
    background: var(--cream);
  }

  .service-card__chevron {
    display: none;
  }

  /* Compact list — stops the tall photo-card scroll trap on phones */
  @media (max-width: 900px) {
    .services .section-title {
      max-width: none;
      font-size: clamp(1.65rem, 7vw, 2.15rem);
    }

    .services__bento {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-top: 1.25rem;
      min-height: 0;
      border: 3px solid var(--ink);
      background: var(--white);
      box-shadow: 4px 4px 0 var(--blue);
      overflow: hidden;
    }

    .service-card,
    .service-card--featured {
      display: flex;
      flex-direction: row;
      grid-row: auto;
      align-items: center;
      gap: 0.65rem;
      min-height: 0;
      aspect-ratio: auto;
      padding: 0.7rem 0.75rem;
      border: 0;
      border-bottom: 2px solid rgba(21, 21, 21, 0.12);
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
      color: var(--ink);
      background: var(--white);
    }

    .service-card:last-child {
      border-bottom: 0;
    }

    .service-card:hover,
    .service-card:focus-visible {
      transform: none;
      box-shadow: none;
      background: var(--cream);
    }

    .service-card::before {
      display: none;
    }

    .service-card__bg {
      position: relative;
      inset: auto;
      flex-shrink: 0;
      width: 4.25rem;
      height: 4.25rem;
      border: 2px solid var(--ink);
      transform: none !important;
    }

    .service-card--featured .service-card__bg {
      object-position: center;
    }

    .service-card__number {
      position: static;
      flex-shrink: 0;
      width: 2.25rem;
      font-size: 1.15rem;
      line-height: 1;
      color: var(--blue);
      opacity: 1;
      text-shadow: none;
      order: -1;
    }

    .service-card--featured .service-card__number {
      font-size: 1.15rem;
      top: auto;
      right: auto;
    }

    .service-card__copy {
      flex: 1;
      width: auto;
      min-width: 0;
      padding: 0;
      gap: 0.2rem;
    }

    .service-card--featured .service-card__copy {
      padding: 0;
      max-width: none;
    }

    .service-card h3,
    .service-card--featured h3 {
      font-size: 1.1rem;
      max-width: none;
      color: var(--ink);
    }

    .service-card p,
    .service-card--featured p {
      max-width: none;
      font-size: 0.82rem;
      line-height: 1.3;
      color: #5c564c;
    }

    .service-card__cta {
      display: none;
    }

    .service-card__chevron {
      display: block;
      flex-shrink: 0;
      font-family: var(--font-display);
      font-size: 1.75rem;
      line-height: 1;
      color: var(--blue);
    }
  }
</style>
