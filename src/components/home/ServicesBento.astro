---
import { legacyImages, serviceLegacyImage } from '../../data/legacyImages';
import { services } from '../../data/services';

const teasers: Record<string, string> = {
  'pest-control': 'Targeted home treatments after a real inspection.',
  'rodent-control': 'Trap, remove, and seal the entry points.',
  'termite-control': 'Inspect the structure. Stop the damage.',
  'commercial-services': 'Keep pests out of customer view.',
};

/** Heroic lead visual for the featured residential card */
const featuredImage = legacyImages.bannerTechnician;
---

<section class="section services" id="services" aria-labelledby="services-heading">
  <div class="container">
    <p class="section-label">Services</p>
    <h2 class="section-title" id="services-heading">Solutions built for your space.</h2>
    <p class="section-lead">Homes, businesses, and the pests that don’t belong in either.</p>

    <div class="services__bento">
      {
        services.map((service, index) => {
          const image =
            index === 0 ? featuredImage : serviceLegacyImage[service.id];
          const featured = index === 0;
          return (
            <a
              class={`service-card${featured ? ' service-card--featured' : ''}`}
              href={service.href}
            >
              {image && (
                <img
                  class="service-card__bg"
                  src={image.src}
                  alt=""
                  width={image.width}
                  height={image.height}
                  loading={featured ? 'eager' : 'lazy'}
                  decoding="async"
                  aria-hidden="true"
                />
              )}
              <span class="service-card__number" aria-hidden="true">
                {service.number}
              </span>
              <div class="service-card__copy">
                <h3>{service.navLabel}</h3>
                <p>{teasers[service.id]}</p>
                <span class="service-card__cta">Explore service →</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .services__bento {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-template-rows: repeat(3, minmax(11rem, 1fr));
    gap: 1rem;
    margin-top: 2.25rem;
    min-height: min(72vh, 38rem);
  }

  .service-card {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 11rem;
    border: 4px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 6px 6px 0 var(--ink);
    overflow: hidden;
    text-decoration: none;
    color: var(--cream);
    background: var(--ink);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .service-card--featured {
    grid-row: 1 / -1;
    min-height: 100%;
  }

  .service-card:hover,
  .service-card:focus-visible {
    transform: translate(-5px, -5px);
    box-shadow: 10px 10px 0 var(--blue);
  }

  .service-card__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 280ms ease;
  }

  .service-card--featured .service-card__bg {
    object-position: left center;
  }

  .service-card:hover .service-card__bg {
    transform: scale(1.05);
  }

  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      185deg,
      rgba(21, 21, 21, 0.05) 20%,
      rgba(21, 21, 21, 0.45) 55%,
      rgba(21, 21, 21, 0.88) 100%
    );
    pointer-events: none;
  }

  .service-card__number {
    position: absolute;
    top: 0.65rem;
    right: 0.75rem;
    z-index: 2;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 0.8;
    color: var(--yellow);
    opacity: 0.9;
    text-shadow: 3px 3px 0 var(--ink);
    pointer-events: none;
  }

  .service-card--featured .service-card__number {
    font-size: clamp(5rem, 12vw, 9rem);
    top: 1rem;
    right: 1rem;
  }

  .service-card__copy {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 1.15rem 1.2rem 1.25rem;
    display: grid;
    gap: 0.45rem;
  }

  .service-card--featured .service-card__copy {
    padding: 1.5rem 1.6rem 1.75rem;
    max-width: 28rem;
  }

  .service-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3.5vw, 2.35rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--cream);
  }

  .service-card--featured h3 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    max-width: 10ch;
  }

  .service-card p {
    margin: 0;
    max-width: 34ch;
    font-size: 0.98rem;
    line-height: 1.35;
    color: rgba(247, 243, 232, 0.92);
  }

  .service-card--featured p {
    font-size: 1.1rem;
  }

  .service-card__cta {
    display: inline-flex;
    align-self: start;
    margin-top: 0.35rem;
    padding: 0.55rem 0.8rem;
    background: var(--yellow);
    border: 3px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-card:hover .service-card__cta {
    background: var(--cream);
  }

  @media (max-width: 900px) {
    .services__bento {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      min-height: 0;
    }

    .service-card--featured {
      grid-row: auto;
      min-height: min(58vh, 28rem);
      aspect-ratio: 4 / 5;
    }

    .service-card:not(.service-card--featured) {
      min-height: 16rem;
      aspect-ratio: 16 / 10;
    }
  }
</style>
