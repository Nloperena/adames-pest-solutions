---
import { trustBadges, testimonials } from '../../data/testimonials';
---

<section class="section trust" aria-labelledby="trust-heading">
  <div class="container">
    <p class="section-label">Trust</p>
    <h2 class="section-title" id="trust-heading">Local answers for Florida pest pressure.</h2>
    <p class="section-lead">
      Inspection-first service for St. Cloud and Central Florida — clear plans for homes and
      businesses.
    </p>

    <div class="trust__stats">
      {
        trustBadges.map((badge) => (
          <article class="trust__stat panel">
            <h3>{badge.title}</h3>
            <p>{badge.detail}</p>
          </article>
        ))
      }
    </div>

    {
      testimonials.length > 0 && (
        <ul class="trust__quotes">
          {testimonials.map((item) => (
            <li class="trust__quote panel">
              <blockquote>
                <p>“{item.quote}”</p>
                <footer>
                  <cite>
                    {item.name}
                    <span> · {item.location}</span>
                  </cite>
                </footer>
              </blockquote>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .trust__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin: 2rem 0 0;
  }

  .trust__stat {
    padding: 1.1rem;
  }

  .trust__stat h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-transform: uppercase;
  }

  .trust__stat p {
    margin: 0.55rem 0 0;
  }

  .trust__quotes {
    display: grid;
    gap: 0.85rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .trust__quote {
    padding: 1.1rem;
  }

  @media (max-width: 800px) {
    .trust.section {
      padding-block: 2rem;
    }

    .trust .section-title {
      max-width: none;
      font-size: clamp(1.55rem, 6.5vw, 2rem);
    }

    .trust .section-lead {
      display: none;
    }

    .trust__stats {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 1.1rem;
      border: 3px solid var(--ink);
      overflow: hidden;
      box-shadow: 4px 4px 0 var(--ink);
    }

    .trust__stats .trust__stat {
      padding: 0.8rem 0.9rem;
      border: 0;
      border-bottom: 2px solid rgba(21, 21, 21, 0.12);
      border-radius: 0;
      box-shadow: none;
      background: var(--white);
    }

    .trust__stat:nth-child(odd) {
      background: var(--cream);
    }

    .trust__stat:last-child {
      border-bottom: 0;
    }

    .trust__stat h3 {
      font-size: 0.95rem;
      color: var(--blue);
    }

    .trust__stat p {
      margin: 0.25rem 0 0;
      font-size: 0.88rem;
      line-height: 1.35;
      color: #5c564c;
    }
  }
</style>
