---
import ContentPage from '../layouts/ContentPage.astro';
import { spanishPage } from '../data/pages';
---

<ContentPage
  title={spanishPage.seo.title}
  description={spanishPage.seo.description}
  h1={spanishPage.h1}
  lead={spanishPage.intro[0]}
  lang="es"
  crumbs={[{ label: 'Inicio', href: '/' }, { label: 'Se Habla Español' }]}
  mediaSrc="/images/generated/espanol/familia-hogar.webp"
  mediaAlt="Hogar en Florida Central para servicios de control de plagas"
>
  {spanishPage.intro.slice(1).map((p) => <p>{p}</p>)}
  {
    spanishPage.sections.map((section) => {
      const list = 'list' in section ? section.list : undefined;
      return (
        <>
          <h2>{section.heading}</h2>
          {section.body.map((p) => <p>{p}</p>)}
          {list && (
            <ul>
              {list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </>
      );
    })
  }
  <p>{spanishPage.ctaNote}</p>
</ContentPage>
