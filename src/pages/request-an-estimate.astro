---
import ContentPage from '../layouts/ContentPage.astro';
import LeadForm from '../components/react/LeadForm';
import { estimatePage } from '../data/pages';
import { primaryEmailHref, primaryPhone, primaryPhoneHref, site } from '../data/site';
---

<ContentPage
  title={estimatePage.seo.title}
  description={estimatePage.seo.description}
  h1={estimatePage.h1}
  lead={estimatePage.intro[0]}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Request an Estimate' }]}
  mediaSrc="/images/generated/estimate/clipboard.webp"
  mediaAlt="Clipboard graphic for scheduling a pest estimate"
  mediaWidth={900}
  mediaHeight={1350}
  formAction="estimate"
  hideCta={true}
  compactHero={true}
>
  <div class="estimate-page">
    <p class="estimate-page__note">
      Call <a href={primaryPhoneHref()}>{primaryPhone()}</a>
      ·
      <a href={primaryEmailHref()}>email the office</a>
      — or send the short form below.
    </p>
    <LeadForm client:load kind="estimate" idPrefix="page" compact />
  </div>
</ContentPage>

<style>
  .estimate-page {
    display: grid;
    gap: 0.85rem;
    max-width: 34rem;
  }

  .estimate-page__note {
    margin: 0;
    font-size: 0.95rem;
  }
</style>
