---
import ContentPage from '../layouts/ContentPage.astro';
import LeadForm from '../components/react/LeadForm';
import { contactPage } from '../data/pages';
import {
  businessName,
  primaryEmail,
  primaryEmailHref,
  primaryPhone,
  primaryPhoneHref,
  site,
} from '../data/site';
---

<ContentPage
  title={contactPage.seo.title}
  description={contactPage.seo.description}
  h1={contactPage.h1}
  lead={contactPage.intro[0]}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact Us' }]}
  mediaSrc="/images/generated/contact/phone-panel.webp"
  mediaAlt="Graphic contact panel with space for phone details"
  mediaWidth={900}
  mediaHeight={1350}
  formAction="contact"
  hideCta={true}
  compactHero={true}
>
  <div class="contact-page">
    <div class="contact-facts panel">
      <h2>Office</h2>
      <p>
        <a href={primaryPhoneHref()}>{primaryPhone()}</a>
        ·
        <a href={primaryEmailHref()}>{primaryEmail()}</a><br />
        {site.hours.weekdays}
      </p>
    </div>

    <div class="contact-form-block">
      <h2>Send a message</h2>
      <p class="contact-form-block__note">
        Tell us the pest problem and your location. Prefer the phone? Call {businessName()} at{' '}
        <a href={primaryPhoneHref()}>{primaryPhone()}</a>.
      </p>
      <LeadForm client:load kind="contact" idPrefix="page" compact />
    </div>
  </div>
</ContentPage>

<style>
  .contact-page {
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
  }

  .contact-facts {
    padding: 0.85rem 1rem;
    margin: 0;
  }

  .contact-facts h2,
  .contact-form-block h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.25rem, 2.5vw, 1.55rem);
  }

  .contact-facts p,
  .contact-form-block__note {
    margin: 0;
    font-size: 0.95rem;
  }

  .contact-form-block {
    display: grid;
    gap: 0.65rem;
  }
</style>
