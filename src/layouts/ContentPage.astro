---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/CTAButton.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { primaryPhoneHref, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  h1: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
  mediaSrc?: string;
  mediaAlt?: string;
  mediaWidth?: number;
  mediaHeight?: number;
  formAction?: 'contact' | 'estimate';
  hideCta?: boolean;
  lang?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  h1,
  lead,
  crumbs,
  mediaSrc,
  mediaWidth = 1536,
  mediaHeight = 1024,
  formAction = 'estimate',
  hideCta = false,
  lang,
  noindex,
  schema,
} = Astro.props;
---

<BaseLayout title={title} description={description} schema={schema} lang={lang} noindex={noindex}>
  <section class={`page-hero${mediaSrc ? ' page-hero--media' : ''}`} aria-labelledby="page-hero-heading">
    {
      mediaSrc && (
        <div class="page-hero__plane" aria-hidden="true">
          <img
            src={mediaSrc}
            alt=""
            width={mediaWidth}
            height={mediaHeight}
            class="page-hero__image"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }
    <div class="container page-hero__content">
      <Breadcrumbs items={crumbs} tone="light" />
      <p class="page-hero__brand">{site.name}</p>
      <h1 id="page-hero-heading">{h1}</h1>
      {lead && <p class="page-hero__lead">{lead}</p>}
      <div class="page-hero__cta">
        <CTAButton href={primaryPhoneHref()} variant="blue">{site.cta.callLabel}</CTAButton>
        <CTAButton action={formAction}>
          {formAction === 'contact' ? `${site.cta.contactLabel} →` : `${site.cta.estimateLabel} →`}
        </CTAButton>
      </div>
    </div>
  </section>

  <main id="main" class="section content-page">
    <div class="container content-page__article">
      <slot />
    </div>
  </main>

  {!hideCta && <FinalCta />}
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(72vh, 36rem);
    padding: clamp(4.5rem, 10vh, 6rem) 0 clamp(2rem, 5vh, 3rem);
    overflow: hidden;
    background: var(--blue);
    color: var(--cream);
  }

  .page-hero--media {
    background: var(--ink);
  }

  .page-hero__plane {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .page-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
  }

  .page-hero--media .page-hero__plane::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(21, 21, 21, 0.9) 0%, rgba(21, 21, 21, 0.62) 55%, rgba(21, 21, 21, 0.35) 100%),
      linear-gradient(180deg, rgba(21, 21, 21, 0.25) 0%, rgba(21, 21, 21, 0.78) 100%);
  }

  .page-hero__content {
    position: relative;
    max-width: 44rem;
  }

  .page-hero__brand {
    margin: 0 0 0.85rem;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3.8vw, 2.35rem);
    line-height: 0.92;
    text-transform: uppercase;
    color: var(--yellow);
  }

  .page-hero h1 {
    margin: 0 0 1rem;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 0.92;
    text-transform: uppercase;
  }

  .page-hero__lead {
    margin: 0 0 1.5rem;
    max-width: 42ch;
    font-size: 1.0625rem;
    color: rgba(247, 243, 232, 0.92);
  }

  .page-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .content-page__article :global(h2) {
    margin: 2rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .content-page__article :global(p),
  .content-page__article :global(li) {
    max-width: 62ch;
  }

  .content-page__article :global(ul) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .content-page__article :global(li) {
    padding: 0.55rem 0.7rem;
    border: 2px solid var(--ink);
    background: var(--white);
    font-weight: 700;
  }

  .content-page__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 860px) {
    .content-page__article :global(ul) {
      grid-template-columns: 1fr;
    }

    .page-hero {
      min-height: min(68vh, 32rem);
    }
  }
</style>
